{
  "name": "freespace-desktop-ui",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "description": "React interface of the FreeSpace desktop client (Tauri 2)",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite --port 1420 --strictPort",
    "build": "npm run gen:i18n && tsc --noEmit && vite build",
    "preview": "vite preview --port 1420 --strictPort",
    "tauri": "cd .. && node ui/node_modules/@tauri-apps/cli/tauri.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "gen:i18n": "node scripts/gen-i18n.mjs",
    "check:i18n": "node scripts/gen-i18n.mjs --check",
    "check:tokens": "node scripts/check-tokens.mjs",
    "check:network": "node scripts/check-network.mjs",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --project=e2e --pass-with-no-tests",
    "test:visual": "playwright test --project=visual --pass-with-no-tests",
    "test:visual:pr": "playwright test --project=pr --pass-with-no-tests",
    "test:visual:update": "playwright test --project=visual --update-snapshots",
    "gallery": "node scripts/gen-gallery.mjs",
    "test:a11y": "playwright test --project=a11y --pass-with-no-tests",
    "test:tauri": "wdio run ../../../tests/tauri_e2e/wdio.conf.ts"
  },
  "dependencies": {
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.13.12",
    "@tauri-apps/api": "^2.12.4",
    "lucide-react": "0.468.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.65.1",
    "@tauri-apps/cli": "^2.12.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.7.0",
    "@wdio/cli": "^9.20.0",
    "@wdio/local-runner": "^9.20.0",
    "@wdio/mocha-framework": "^9.20.0",
    "@wdio/spec-reporter": "^9.20.0",
    "edgedriver": "^8.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^26.1.0",
    "smol-toml": "^1.9.1",
    "ts-node": "^10.9.2",
    "typescript": "5.6.3",
    "typescript-eslint": "^8.72.2",
    "vite": "6.4.5",
    "vitest": "^3.2.4",
    "webdriverio": "^9.20.0"
  }
}
